set +e

RTK_BIN="/sandbox/workspace/.costwise/rtk"

if [ -f "${RTK_BIN}" ]; then
  chmod +x "${RTK_BIN}" 2>/dev/null
  export PATH="/sandbox/workspace/.costwise:${PATH}"
  export CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-/sandbox/claude-config}"

  # Use rtk init to register in $CLAUDE_CONFIG_DIR/settings.json
  "${RTK_BIN}" init -g --hook-only --auto-patch 2>/dev/null

  # Inject RTK into workspace settings.json (where security hooks live)
  WS_SETTINGS="/sandbox/workspace/.claude/settings.json"
  echo "[rtk-setup] WS_SETTINGS=${WS_SETTINGS} exists=$([ -f "${WS_SETTINGS}" ] && echo yes || echo no)" >&2
  echo "[rtk-setup] CLAUDE_CONFIG_DIR=${CLAUDE_CONFIG_DIR}" >&2
  echo "[rtk-setup] jq=$(command -v jq 2>/dev/null || echo 'NOT FOUND')" >&2

  if [ -f "${WS_SETTINGS}" ]; then
    echo "[rtk-setup] WS settings.json content:" >&2
    cat "${WS_SETTINGS}" >&2
    if command -v jq >/dev/null 2>&1; then
      jq --arg cmd "${RTK_BIN} hook claude" '
        .hooks.PreToolUse = [{"matcher":"Bash","hooks":[{"type":"command","command":$cmd}]}]
          + (.hooks.PreToolUse // [])
      ' "${WS_SETTINGS}" > "${WS_SETTINGS}.tmp" && mv "${WS_SETTINGS}.tmp" "${WS_SETTINGS}"
      echo "[rtk-setup] After RTK injection:" >&2
      cat "${WS_SETTINGS}" >&2
    else
      echo "[rtk-setup] jq not available, cannot inject" >&2
    fi
  fi

  # Also check CLAUDE_CONFIG_DIR settings
  CC_SETTINGS="${CLAUDE_CONFIG_DIR}/settings.json"
  echo "[rtk-setup] CC_SETTINGS=${CC_SETTINGS} exists=$([ -f "${CC_SETTINGS}" ] && echo yes || echo no)" >&2
  if [ -f "${CC_SETTINGS}" ]; then
    echo "[rtk-setup] CC settings.json content:" >&2
    cat "${CC_SETTINGS}" >&2
  fi
fi

export PONYTAIL_DEFAULT_MODE="${PONYTAIL_DEFAULT_MODE:-full}"

set -e
