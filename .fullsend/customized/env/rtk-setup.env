set +e

RTK_BIN="/sandbox/workspace/.costwise/rtk"

if [ -f "${RTK_BIN}" ]; then
  chmod +x "${RTK_BIN}" 2>/dev/null
  export PATH="/sandbox/workspace/.costwise:${PATH}"
  export CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-/sandbox/claude-config}"

  # Register RTK hook in workspace settings.json (alongside security hooks)
  "${RTK_BIN}" init -g --hook-only --auto-patch 2>/dev/null
fi

export PONYTAIL_DEFAULT_MODE="${PONYTAIL_DEFAULT_MODE:-full}"

set -e
