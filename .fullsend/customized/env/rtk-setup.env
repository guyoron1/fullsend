set +e

RTK_BIN="/sandbox/workspace/.costwise/rtk"
SETTINGS="/sandbox/claude-config/settings.json"

if [ -f "${RTK_BIN}" ]; then
  chmod +x "${RTK_BIN}" 2>/dev/null
  export PATH="/sandbox/workspace/.costwise:${PATH}"

  if [ -f "${SETTINGS}" ] && command -v jq >/dev/null 2>&1; then
    HAS_RTK=$(jq '(.hooks.PreToolUse // []) | [.[].hooks[]?.command // ""] | map(select(contains("rtk"))) | length' \
      "${SETTINGS}" 2>/dev/null || echo "0")

    if [ "${HAS_RTK}" = "0" ]; then
      jq --arg cmd "${RTK_BIN} hook claude" '
        .hooks.PreToolUse = [{"matcher":"Bash","hooks":[{"type":"command","command":$cmd}]}]
          + (.hooks.PreToolUse // [])
      ' "${SETTINGS}" > "${SETTINGS}.tmp" && mv "${SETTINGS}.tmp" "${SETTINGS}"
    fi
  fi
fi

export PONYTAIL_DEFAULT_MODE="${PONYTAIL_DEFAULT_MODE:-full}"

set -e
