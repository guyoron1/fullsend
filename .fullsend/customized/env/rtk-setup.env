set +e

RTK_BIN="/sandbox/workspace/.costwise/rtk"

if [ -f "${RTK_BIN}" ]; then
  chmod +x "${RTK_BIN}" 2>/dev/null
  export PATH="/sandbox/workspace/.costwise:${PATH}"

  # RTK resolves Claude config via $CLAUDE_CONFIG_DIR
  # FullSend sets CLAUDE_CONFIG_DIR=/sandbox/claude-config in .env
  export CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-/sandbox/claude-config}"

  # Initialize RTK so "rtk hook claude" actually filters output
  "${RTK_BIN}" init -g --hook-only --no-patch 2>/dev/null

  # Merge RTK PreToolUse hook into BOTH settings.json locations
  # Claude Code reads hooks from workspace/.claude/ AND $CLAUDE_CONFIG_DIR/
  _rtk_inject_hook() {
    local sf="$1"
    if [ -f "${sf}" ] && command -v jq >/dev/null 2>&1; then
      HAS_RTK=$(jq '(.hooks.PreToolUse // []) | [.[].hooks[]?.command // ""] | map(select(contains("rtk"))) | length' \
        "${sf}" 2>/dev/null || echo "0")
      if [ "${HAS_RTK}" = "0" ]; then
        jq --arg cmd "${RTK_BIN} hook claude" '
          .hooks.PreToolUse = [{"matcher":"Bash","hooks":[{"type":"command","command":$cmd}]}]
            + (.hooks.PreToolUse // [])
        ' "${sf}" > "${sf}.tmp" && mv "${sf}.tmp" "${sf}"
      fi
    fi
  }

  _rtk_inject_hook "/sandbox/workspace/.claude/settings.json"
  _rtk_inject_hook "/sandbox/claude-config/settings.json"

  unset -f _rtk_inject_hook
fi

export PONYTAIL_DEFAULT_MODE="${PONYTAIL_DEFAULT_MODE:-full}"

set -e
